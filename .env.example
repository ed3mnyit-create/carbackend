# إعدادات الخادم (Server Configuration)
# المنفذ الذي سيعمل عليه الخادم محلياً (مثلاً: 5000)
PORT=5000

# بيئة العمل:
# استخدم 'development' في بيئة التطوير المحلية (Local)
# استخدم 'production' عند رفع المشروع على الاستضافة (مثل Vercel)
NODE_ENV=development

# ----------------------------------------------------

# قاعدة البيانات (MongoDB Database)
# رابط الاتصال بقاعدة بيانات MongoDB.
# - محلياً (Local): استخدم رابط مثل mongodb://localhost:27017/c4r
# - في الإنتاج (Production): احصل على الرابط من حسابك في MongoDB Atlas، ويكون بالشكل mongodb+srv://<user>:<password>@cluster0.mongodb.net/c4r
MONGODB_URI=

# ----------------------------------------------------

# المصادقة والحماية (JWT Authentication)
# الكلمة السرية المستخدمة لتشفير الـ Tokens (JWT).
# يجب أن تكون سلسلة نصوص عشوائية وطويلة جداً (مثل: d8f9e... أو أي نص معقد).
# يمكنك توليد واحدة عشوائية وتثبيتها هنا. لا تشاركها أبداً!
JWT_SECRET=

# مدة صلاحية الـ Token.
# يمكنك كتابة المدة بالأيام (مثلاً 7d) أو بالساعات (مثلاً 24h).
JWT_EXPIRE=7d

# ----------------------------------------------------

# إعدادات السياسات والمشاركة (CORS Configuration)
# النطاق (Domain) المسموح له بالاتصال بالباك إند.
# - محلياً (Local): استخدم * للسماح للجميع، أو ضع رابط الفرونت إند مثل http://localhost:3000
# - في الإنتاج (Production): يجب أن تضع رابط الفرونت إند الفعلي مثل https://your-frontend-domain.com
CORS_ORIGIN=*

# ----------------------------------------------------

# إعدادات البريد الإلكتروني (Email Configuration) - اختياري لنسيان كلمة المرور
# خادم إرسال الإيميلات (SMTP Host).
# يمكنك الحصول عليه من موفر خدمة الإيميل (مثل: smtp.gmail.com أو smtp.mailtrap.io).
EMAIL_HOST=

# منفذ الاتصال بالبريد (SMTP Port).
# عادةً يكون 587 لاتصال TLS أو 465 لاتصال SSL.
EMAIL_PORT=587

# اسم المستخدم أو الإيميل الذي سيرسل منه (SMTP User).
EMAIL_USER=

# كلمة المرور للإيميل (أو App Password إذا كنت تستخدم Gmail ومفعل خطوتين).
# لا تضع كلمة المرور العادية لبريدك هنا أبداً.
EMAIL_PASS=

# العنوان الذي سيظهر للمستلم كمرسل (مثال: C4R Support <support@c4r.com>).
EMAIL_FROM=
